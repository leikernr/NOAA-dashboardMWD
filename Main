    ).add_to(m)

for bid in selected_buoys:
    lat, lon = buoy_info[bid][1], buoy_info[bid][2]
    rt = buoy_data[bid]
    is_active = (bid == primary)

    popup_html = f"""
    <div style="font-family: monospace; min-width: 180px;">
        <b>{bid}</b> — <i>{buoy_info[bid][0]}</i><br>
        <hr style="margin:4px 0;">
