def haversine(lat1, lon1, lat2, lon2):
    R = 3958.8
    dlat = radians(lat2 - lat1)
    dlon = radians(lon2 - lon1)
    a = sin(dlat/2)**2 + cos(radians(lat1)) * cos(radians(lat2)) * sin(dlon/2)**2
    c = 2 * atan2(sqrt(a), sqrt(1 - a))
    return R * c

# ========================================
# MINIMUM CURVATURE ENGINE (SPE / API STANDARD)
# ========================================
def calculate_minimum_curvature(md_arr, inc_arr, azi_arr):
    n = len(md_arr)
    tvd, ns, ew, dls = np.zeros(n), np.zeros(n), np.zeros(n), np.zeros(n)
    inc = np.radians(inc_arr)
    azi = np.radians(azi_arr)

    for i in range(1, n):
        d_md = md_arr[i] - md_arr[i-1]
        if d_md <= 0:
            tvd[i], ns[i], ew[i] = tvd[i-1], ns[i-1], ew[i-1]
            continue

        i1, i2 = inc[i-1], inc[i]
        a1, a2 = azi[i-1], azi[i]

        cos_dl = np.cos(i2 - i1) - (np.sin(i1) * np.sin(i2) * (1.0 - np.cos(a2 - a1)))
        dl = np.arccos(np.clip(cos_dl, -1.0, 1.0))
        rf = 1.0 if dl < 1e-6 else (2.0 / dl) * np.tan(dl / 2.0)

        tvd[i] = tvd[i-1] + (d_md / 2.0) * (np.cos(i1) + np.cos(i2)) * rf
        ns[i]  = ns[i-1]  + (d_md / 2.0) * (np.sin(i1) * np.cos(a1) + np.sin(i2) * np.cos(a2)) * rf
        ew[i]  = ew[i-1]  + (d_md / 2.0) * (np.sin(i1) * np.sin(a1) + np.sin(i2) * np.sin(a2)) * rf
        dls[i] = np.degrees(dl) * (100.0 / d_md)

    vs = np.sqrt(ns**2 + ew**2)
    return pd.DataFrame({'TVD': tvd, 'NS': ns, 'EW': ew, 'VS': vs, 'DLS': dls})

# ========================================
# ROBUST LAS & SURVEY PARSER
# ========================================
def parse_mwd_file(file_bytes_or_str):
    if isinstance(file_bytes_or_str, bytes):
        text = file_bytes_or_str.decode('utf-8', errors='ignore')
    elif hasattr(file_bytes_or_str, 'read'):
        text = file_bytes_or_str.read().decode('utf-8', errors='ignore')
    else:
        text = str(file_bytes_or_str)

    lines = text.splitlines()
    header_info = {}
    survey_lines, ascii_lines, curve_names = [], [], []
    current_sec = None

    for line in lines:
        s = line.strip()
        if not s:
            continue
        if s.startswith('~'):
            sec = s[1:].upper()
            if sec.startswith('V'): current_sec = 'VERSION'
            elif sec.startswith('W'): current_sec = 'WELL'
            elif sec.startswith('C'): current_sec = 'CURVE'
            elif sec.startswith('P'): current_sec = 'PARAM'
            elif sec.startswith('O'): current_sec = 'OTHER'
            elif sec.startswith('A'): current_sec = 'ASCII'
            else: current_sec = sec
            continue

        if current_sec == 'WELL':
            m = re.match(r'^([^.]+)\.([^\:]*)\:(.*)$', line)
            if m:
                header_info[m.group(1).strip()] = {'value': m.group(2).strip(), 'desc': m.group(3).strip()}
        elif current_sec == 'OTHER':
            survey_lines.append(s)
        elif current_sec == 'CURVE':
            m = re.match(r'^([^.]+)\.([^\:]*)\:(.*)$', line)
            if m:
                curve_names.append(m.group(1).strip())
        elif current_sec == 'ASCII':
            ascii_lines.append(s)

    # 1. Parse survey table from ~Other (Noralis / WellBenders NISE format)
    df_survey = None
    if survey_lines:
        header_idx = -1
        for i, l in enumerate(survey_lines):
            ul = l.upper()
            if 'DEPTH' in ul or 'INCL' in ul or 'TVD' in ul:
                header_idx = i
                break

        if header_idx != -1:
            raw_cols = re.sub(r'[#]', '', survey_lines[header_idx]).split()
            clean_cols = []
            for c in raw_cols:
                cu = c.upper()
                if 'DEPTH' in cu or cu == 'MD': clean_cols.append('MD')
                elif 'INC' in cu: clean_cols.append('INC')
                elif 'AZM' in cu or 'AZI' in cu: clean_cols.append('AZI')
                elif 'TVD' in cu: clean_cols.append('TVD')
                elif cu in ['VS', 'VSEC', 'VERT_SECT']: clean_cols.append('VS')
                elif 'N/' in cu or 'NORTH' in cu or cu == 'NS': clean_cols.append('NS')
                elif 'E/' in cu or 'EAST' in cu or cu == 'EW': clean_cols.append('EW')
                elif 'DLS' in cu: clean_cols.append('DLS')
                elif 'TRACK' in cu: clean_cols.append('TRACK')
                elif 'SURV' in cu: clean_cols.append('SURVEY')
                else: clean_cols.append(c)

            records = []
            for l in survey_lines[header_idx+1:]:
                if not l or l.startswith('#'): continue
                parts = l.split()
                if len(parts) < len(clean_cols): continue
                if len(parts) > len(clean_cols):
                    if len(parts) == len(clean_cols) + 1 and parts[1].upper() == 'TIE' and parts[2].upper() == 'IN':
                        parts = [parts[0], 'Tie In'] + parts[3:]
                    else:
                        excess = len(parts) - len(clean_cols)
                        merged = ' '.join(parts[1:1+excess+1])
                        parts = [parts[0], merged] + parts[1+excess+1:]
                records.append(parts[:len(clean_cols)])

            if records:
                df_survey = pd.DataFrame(records, columns=clean_cols)
                for num_col in ['MD', 'INC', 'AZI', 'TVD', 'VS', 'NS', 'EW', 'DLS']:
                    if num_col in df_survey.columns:
                        df_survey[num_col] = pd.to_numeric(df_survey[num_col], errors='coerce')

    # 2. Parse continuous log curves from ~A
    df_log = None
    if ascii_lines and curve_names:
        log_rows = [l.split() for l in ascii_lines if l.strip()]
        if log_rows:
            ncols = min(len(curve_names), len(log_rows[0]))
            df_log = pd.DataFrame(log_rows, columns=curve_names[:ncols])
            for c in df_log.columns:
                df_log[c] = pd.to_numeric(df_log[c], errors='coerce')
                df_log.loc[df_log[c] < -900, c] = np.nan

    # 3. Fallback: CSV if ~Other was not present
    if df_survey is None:
        try:
            df_raw = pd.read_csv(io.StringIO(text))
            col_map = {}
            for c in df_raw.columns:
                cu = str(c).upper().strip()
                if 'DEPTH' in cu or cu == 'MD': col_map[c] = 'MD'
                elif 'INC' in cu: col_map[c] = 'INC'
                elif 'AZ' in cu: col_map[c] = 'AZI'
                elif 'TVD' in cu: col_map[c] = 'TVD'
                elif 'N/' in cu or cu == 'NS': col_map[c] = 'NS'
                elif 'E/' in cu or cu == 'EW': col_map[c] = 'EW'
                elif 'VS' in cu: col_map[c] = 'VS'
                elif 'DLS' in cu: col_map[c] = 'DLS'
            if 'MD' in col_map.values() and 'INC' in col_map.values() and 'AZI' in col_map.values():
                df_survey = df_raw.rename(columns=col_map)
                for c in ['MD', 'INC', 'AZI', 'TVD', 'NS', 'EW', 'VS', 'DLS']:
                    if c in df_survey.columns:
                        df_survey[c] = pd.to_numeric(df_survey[c], errors='coerce')
        except Exception:
            pass

    # 4. If TVD / NS / EW are missing, compute using Minimum Curvature
    if df_survey is not None and not df_survey.empty:
        df_survey = df_survey.dropna(subset=['MD']).sort_values('MD').reset_index(drop=True)
        needed = ['TVD', 'NS', 'EW', 'VS', 'DLS']
        if not all(col in df_survey.columns for col in needed):
            if 'INC' in df_survey.columns and 'AZI' in df_survey.columns:
                mc = calculate_minimum_curvature(
                    df_survey['MD'].values,
                    df_survey['INC'].fillna(0).values,
                    df_survey['AZI'].fillna(0).values
                )
                for col in needed:
                    if col not in df_survey.columns or df_survey[col].isna().all():
                        df_survey[col] = mc[col]

    return header_info, df_survey, df_log

